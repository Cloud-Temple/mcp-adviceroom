# ============================================================
# AdviceRoom — WAF Caddy + Coraza Configuration
# ============================================================
# Reverse proxy HTTP sur port 8088 (pas de TLS — géré par le reverse proxy prod)
# Sécurité: DESIGN/SECURITY_AUDIT_V1.md V1-07, V1-11, V1-16
#
# Coraza WAF activé avec OWASP CRS v4 (protection applicative).
# Rate limiting géré par le reverse proxy de production.

{
	# Charger le module Coraza en premier dans la chaîne de directives
	order coraza_waf first
}

:8088 {
	# --- WAF Coraza (OWASP CRS v4) — V1-07 ---
	coraza_waf {
		load_owasp_crs
		directives `
			Include /etc/caddy/crs/crs-setup.conf
			SecAction "id:999999,phase:1,nolog,pass,t:none,setvar:'tx.allowed_methods=GET HEAD POST OPTIONS DELETE PUT PATCH'"
			SecAction "id:999998,phase:1,nolog,pass,t:none,setvar:'tx.inbound_anomaly_score_threshold=5000'"
			Include /etc/caddy/crs/rules/*.conf
			SecRuleEngine On
			SecRequestBodyAccess On
			SecResponseBodyAccess Off
			SecRequestBodyLimit 1048576
			SecRequestBodyNoFilesLimit 131072
			SecAuditEngine RelevantOnly
			SecAuditLog /dev/stderr
		`
	}

	# Pas de TLS — le reverse proxy de production (nginx/traefik) gère HTTPS
	# HSTS et TLS headers sont ajoutés par le reverse proxy prod

	# Sécurité headers (V1-16, appliqués aussi en interne par précaution)
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Referrer-Policy "strict-origin-when-cross-origin"

	# V1-11 : Admin console (proxifié par le WAF)
	handle /admin* {
		reverse_proxy backend:8000
	}

	# Backend API + MCP
	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle /mcp* {
		# Rewrite /mcp → /mcp/ (Starlette mount exige le trailing slash,
		# les clients MCP Streamable HTTP ne suivent pas les 307 POST)
		@mcp_noslash path /mcp
		rewrite @mcp_noslash /mcp/
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# SÉCURITÉ : le frontend React n'est PAS exposé publiquement.
	# L'interface protégée est /admin (SPA admin.html côté backend, auth Bearer).
	# Le frontend React (port 3000) reste en service pour le docker healthcheck
	# mais aucune route WAF ne le proxie.

	# Racine → redirige vers l'admin console (protégée par auth Bearer)
	handle / {
		redir / /admin permanent
	}

	# SÉCURITÉ : toute URL inconnue retourne une 404 propre.
	# Plus aucun catch-all vers le frontend — empêche l'exposition de l'UI
	# (formulaire de création, liste des modèles LLM) sans authentification.
	handle {
		respond "Not Found" 404
	}
}
